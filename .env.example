# BTC Trading Bot Configuration
# Copy this file to .env and fill in your values

# ====================================
# SUPABASE CONFIGURATION (REQUIRED)
# ====================================

# Supabase project URL - get this from your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key - KEEP THIS SECRET! Server-side only
# Get this from Settings > API in your Supabase dashboard
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase anonymous key - safe for client-side use
# Get this from Settings > API in your Supabase dashboard
SUPABASE_ANON_KEY=your-anon-key-here

# ====================================
# BINANCE CONFIGURATION (REQUIRED)
# ====================================

# Binance API key - get this from your Binance account
# Go to: Account -> API Management -> Create API
BINANCE_API_KEY=your-binance-api-key-here

# Binance API secret - KEEP THIS SECRET!
# This is shown only once when you create the API key
BINANCE_API_SECRET=your-binance-api-secret-here

# Use Binance testnet for testing (true/false)
# Testnet: https://testnet.binance.vision/
# Default: true for development, false for production
BINANCE_TESTNET=true

# ====================================
# TRADING CONFIGURATION (REQUIRED)
# ====================================

# Initial capital in USDT for trading
# This is the amount the bot will use for trading
INITIAL_CAPITAL_USDT=300.00

# ====================================
# NOTIFICATION CONFIGURATION (OPTIONAL)
# ====================================

# Discord webhook URL for notifications
# Create a webhook in your Discord server: Server Settings -> Integrations -> Webhooks
# Leave empty to disable Discord notifications
DISCORD_WEBHOOK_URL=

# ====================================
# APPLICATION CONFIGURATION (OPTIONAL)
# ====================================

# Environment mode: development, production, or test
# Defaults to "development" if not set
NODE_ENV=development

# ====================================
# AWS CONFIGURATION (OPTIONAL)
# ====================================

# AWS Secrets Manager configuration for production deployments
# These are optional for MVP - defaults will be used if not set

# AWS region for Secrets Manager (default: us-east-1)
AWS_SECRETS_MANAGER_REGION=us-east-1

# Secret name in AWS Secrets Manager (default: btcbot/config)
AWS_SECRETS_MANAGER_SECRET_NAME=btcbot/config

# ====================================
# NOTES
# ====================================
# 
# 1. Never commit your actual .env file to version control
# 2. Keep your service role key secret - it has full database access
# 3. The NEXT_PUBLIC_ prefix makes variables available to the browser
# 4. In production, consider using AWS Secrets Manager instead of .env files
# 5. Run the application with: npm start or npm run dev
#
# For more information, see the README.md file